# قاعدة البيانات (PostgreSQL)
# لو بتستخدم Supabase: DATABASE_URL هو connection pooling URL، و DIRECT_URL هو
# الاتصال المباشر المطلوب فقط لـ prisma migrate/db push (مش مستخدم وقت التشغيل العادي)
DATABASE_URL="postgresql://user:password@localhost:5432/malaf_pro"
DIRECT_URL="postgresql://user:password@localhost:5432/malaf_pro"

# JWT
JWT_SECRET="your-super-secret-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# AI
GEMINI_API_KEY="your-gemini-api-key"

# Supabase Storage (رفع وتحميل المستندات - إلزامي، مفيش تخزين محلي)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_KEY="your-supabase-service-role-key"
SUPABASE_STORAGE_BUCKET="documents"

# App
PORT=3001
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"
